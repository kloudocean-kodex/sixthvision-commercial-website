# Cloudflare Pages redirects — 301s from the old WordPress site's indexed URLs.
# The site is a multi-page static build. Old service URLs map to the page that
# now covers them, so the equity those URLs earned is kept.
#
# Format: /old-path  /new-path  status
# Matches are exact. /work/lara-… is a real case study and is not affected by
# the /work and /work/ rules below.

# --- old service pages ---
/real-estate-photography      /commercial-property-photography-melbourne/      301
/real-estate-photography/     /commercial-property-photography-melbourne/     301
/commercial-photography       /commercial-property-photography-melbourne/      301
/commercial-photography/      /commercial-property-photography-melbourne/     301
/photography                  /portfolio/      301
/photography/                 /portfolio/      301
/video-drone-media            /commercial-drone-photography-melbourne/     301
/video-drone-media/           /commercial-drone-photography-melbourne/     301
/video                        /commercial-drone-photography-melbourne/     301
/video/                       /commercial-drone-photography-melbourne/     301
/drone                        /commercial-drone-photography-melbourne/     301
/drone/                       /commercial-drone-photography-melbourne/     301
/aerial                       /commercial-drone-photography-melbourne/     301
/aerial/                      /commercial-drone-photography-melbourne/     301
/floor-plans                  /precision-floor-plans/   301
/floor-plans/                 /precision-floor-plans/   301
/precision-floor-plans        /precision-floor-plans/   301

# --- portfolio / about / contact ---
# /portfolio and /portfolio/ are a real page. Do not redirect them.
/gallery                      /portfolio/      301
/gallery/                     /portfolio/      301
/work                         /portfolio/      301
/work/                        /portfolio/      301
/projects                     /portfolio/      301
/projects/                    /portfolio/      301
/about                        /#close     301
/about/                       /#close     301
/about-us                     /#close     301
/about-us/                    /#close     301
/contact                      /#close     301
/contact/                     /#close     301
/contact-us                   /#close     301
/contact-us/                  /#close     301
/services                     /#close     301
/services/                    /#close     301

# --- legacy homepage aliases only ---
# Keep genuine old homepage aliases, but deliberately DO NOT redirect generic
# WordPress archives/runtime paths such as /author/*, /category/*, /tag/*,
# /wp-content/* or /wp-includes/*. Search Console has historical hacked/spam
# URLs under those surfaces. Letting them resolve as a real 404 is the clean
# deindexing signal; redirecting irrelevant spam to / can create soft-404 noise
# and incorrectly associate the homepage with legacy injected content.
/home                         /           301
/home/                        /           301
/index.php                    /           301

# NOTE: no query-string rules here. Cloudflare Pages matches on PATH only.
# Unknown legacy query URLs therefore fall through to the static site's normal
# not-found handling instead of being mass-redirected to the homepage.
#
# Host redirects (www → apex) and "Always Use HTTPS" are zone settings.
# Cloudflare Pages _redirects cannot match a hostname. See the pull request.
