# Cloudflare Pages redirects — 301s from the old WordPress site's indexed URLs.
# The rebuild is one page, so every old section maps to its equivalent chapter
# anchor. This preserves the link equity those URLs have already earned instead
# of dropping ~8 indexed pages into 404s on cutover.
#
# Format: /old-path  /new-path  status

# --- old service pages -> the chapter that now covers them ---
/real-estate-photography      /commercial-property-photography-melbourne/      301
/real-estate-photography/     /commercial-property-photography-melbourne/     301
/commercial-photography       /#work      301
/commercial-photography/      /#work      301
/photography                  /#work      301
/photography/                 /#work      301
/video-drone-media            /#light     301
/video-drone-media/           /#light     301
/video                        /#light     301
/video/                       /#light     301
/drone                        /#light     301
/drone/                       /#light     301
/aerial                       /#light     301
/aerial/                      /#light     301
/floor-plans                  /precision-floor-plans/   301
/floor-plans/                 /precision-floor-plans/   301
/precision-floor-plans        /precision-floor-plans/   301

# --- portfolio / about / contact ---
/portfolio                    /#work      301
/portfolio/                   /#work      301
/gallery                      /#work      301
/gallery/                     /#work      301
/about                        /#close     301
/about/                       /#close     301
/about-us                     /#close     301
/about-us/                    /#close     301
/contact                      /#close     301
/contact/                     /#close     301
/contact-us                   /#close     301
/contact-us/                  /#close     301
